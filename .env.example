NODE_ENV=development
PORT=3000

# Postgres on Space's shared cluster, scribe database.
DATABASE_URL=postgres://trivorn:CHANGEME@shared-postgres:5432/scribe

# Whisper-stream service on Desk's LAN. DHCP means the IP can shift;
# the deploy reads this from a Space var.
WHISPER_STREAM_URL=ws://10.0.0.26:8765
WHISPER_STREAM_HTTP=http://10.0.0.26:8765

# Auth Core OIDC client for browser-side sessions.
OIDC_ISSUER=https://auth.trivorn.org
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Public origin used for OIDC redirect URIs, PRM advertisement, and CORS.
PUBLIC_ORIGIN=https://scribe.trivorn.org

# Cloudflare tunnel token (populated on Space).
CLOUDFLARE_TUNNEL_TOKEN=

# When true, skip auth entirely (dev / test only).
AUTH_DISABLED=false
